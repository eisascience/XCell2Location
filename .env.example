# XCell2Location Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Compute ──────────────────────────────────────────────────────────────────
# Device preference: auto | cpu | cuda | mps
XCELL_DEVICE=auto

# ── Atlas cache ───────────────────────────────────────────────────────────────
# Override the default atlas cache directory (~/.xcell2location/atlas_cache)
# XCELL_ATLAS_CACHE_DIR=/data/atlas_cache

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
XCELL_LOG_LEVEL=INFO

# Optional log file path (leave empty to log to stdout only)
# XCELL_LOG_FILE=/var/log/xcell2location.log

# ── R integration ─────────────────────────────────────────────────────────────
# Path to Rscript executable (auto-detected if not set)
# XCELL_RSCRIPT_PATH=/usr/local/bin/Rscript

# ── Streamlit ─────────────────────────────────────────────────────────────────
# Port for Streamlit GUI (default: 8501)
STREAMLIT_SERVER_PORT=8501
